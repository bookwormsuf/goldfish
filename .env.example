# Template. Copy to .env.local and fill in. Never commit .env.local.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
# Edge Function runtime in production. They are only needed here for local
# `supabase functions serve`, and the local values are printed by `supabase start`.

# From @BotFather when you created the bot
TELEGRAM_BOT_TOKEN=

# Any random 32+ char string. Generate with: openssl rand -hex 32
# Telegram sends this back in the X-Telegram-Bot-Api-Secret-Token header (D4).
TELEGRAM_SECRET_TOKEN=

# Your numeric Telegram chat ID. Get it from @userinfobot. The only chat the
# bot responds to (D5).
ALLOWED_CHAT_ID=

# From console.anthropic.com. Used for topic assignment (D12), step 6 onward.
ANTHROPIC_API_KEY=

# Local only. Printed by `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
